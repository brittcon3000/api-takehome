# ============================================
# Required Configuration
# ============================================

# Stripe webhook signing secret.
# Used to verify webhook authenticity via HMAC signature validation.
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# ============================================
# Optional Configuration
# ============================================

# If true, warning severity events will also be routed to PagerDuty.
# Defaults to false.
ROUTE_WARNING=false

# If provided, the service will fetch real Statuspage data instead of using local fixtures.
# Example:
# SPREEDLY_STATUS_SUMMARY_URL=https://status.spreedly.com/summary.json
SPREEDLY_STATUS_SUMMARY_URL=

# Example:
# BRAZE_STATUS_SUMMARY_URL=https://braze.statuspage.io/summary.json
BRAZE_STATUS_SUMMARY_URL=

# Base URL used for internal routing calls (PagerDuty mock).
# Default is http://localhost:3000
SELF_BASE_URL=http://localhost:3000

# Application port (used primarily for documentation consistency).
PORT=3000